# Server-only. Never prefix these names with VITE_. Never commit real values.
# Existing production booking integration. Keep the current Vercel values.
BOOKING_APPS_SCRIPT_URL=
BOOKING_WEBHOOK_SECRET=
# Optional alternative for direct Sheets integration.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
# Set true only after installing and verifying the Google retention triggers.
BOOKING_RETENTION_AUTOMATION_READY=false
BOOKING_ALLOWED_ORIGINS=https://www.jangseongcar.com,https://jangseong.vercel.app

# Vite frontend AND Vercel board HTML/sitemap functions. Publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never add a service_role or secret key to frontend environment variables.
